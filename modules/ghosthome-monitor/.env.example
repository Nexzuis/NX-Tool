NX_HOST=https://192.168.1.110:7001
NX_USERNAME=admin
NX_PASSWORD=yourpassword
NX_ENGINE_ID=
POLL_INTERVAL_ANALYTICS_MS=600000
POLL_INTERVAL_SERVER_MS=300000
POLL_INTERVAL_ALARMS_MS=60000
LOG_DIR=./logs
DAILY_REPORT_HOUR=6
DAILY_REPORT_HOUR_EVENING=18
MASS_OFFLINE_THRESHOLD=20
API_PORT=4301
API_HOST=127.0.0.1
# Authentication token for write endpoints (POST/PATCH/DELETE).
# When set, requests to write endpoints must include either:
#   Authorization: Bearer <token>   OR   X-API-Key: <token>
# When empty, write endpoints are open (a startup warning is logged).
# Must match NEXT_PUBLIC_API_TOKEN in the frontend .env.
API_AUTH_TOKEN=
# Set to true for NX Witness servers with self-signed TLS certificates
ALLOW_INSECURE_TLS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
